{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Frontend app",
  "private": true,
  "keywords": [
    "frontend",
    "react"
  ],
  "type": "module",
  "main": "src/1_app/index.tsx",
  "scripts": {
    "start:dev": "rspack serve",
    "start:prod": "rspack build",
    "check:all": "pnpm run check:types && pnpm run check:tests:all && pnpm run check:linters && pnpm run check:spell && pnpm run check:knip",
    "check:tests:unit:ts": "vitest --config vitest.unit.node.config.ts",
    "check:tests:unit:tsx": "vitest --config vitest.unit.browser.config.ts",
    "check:tests:unit": "pnpm run check:tests:unit:ts && pnpm run check:tests:unit:tsx",
    "check:tests:int:tsx": "vitest --config vitest.int.browser.config.ts",
    "check:tests:int": "pnpm run check:tests:int:tsx",
    "check:tests:fast": "pnpm run check:tests:unit && pnpm run check:tests:int",
    "check:tests:e2e": "NODE_ENV=e2e playwright test",
    "check:tests:e2e:ui": "NODE_ENV=e2e playwright test --ui",
    "check:tests:all": "pnpm run check:tests:unit && pnpm run check:tests:int && pnpm run check:tests:e2e",
    "check:linters": "pnpm run check:es && pnpm run check:format && pnpm run check:styles",
    "check:es": "eslint --quiet",
    "check:es:all": "eslint",
    "check:es:fix": "eslint --quiet --fix",
    "check:format": "prettier . --check --ignore-unknown",
    "check:format:fix": "prettier . -w --log-level warn",
    "check:knip": "knip --tsConfig tsconfig.app.json --no-exit-code",
    "check:spell": "cspell lint --show-suggestions .",
    "check:styles": "stylelint \"src/**/*.css\"",
    "check:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "check:types": "tsc -p tsconfig.app.json",
    "prettify": "pnpm run check:es:fix && pnpm run check:format:fix && pnpm run check:styles:fix",
    "build": "tsc -p tsconfig.app.json --noEmit false",
    "docs": "typedoc --entryPoints src --out docs/api --tsconfig tsconfig.app.json",
    "generate": "kubb generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mobx": "6.16.1",
    "mobx-react-hook-form": "6.4.1",
    "mobx-route": "2.1.2",
    "mobx-tanstack-query": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.4",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@cspell/dict-en_us": "4.4.37",
    "@cspell/dict-ru_ru": "2.3.2",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@kubb/cli": "5.1.0",
    "@kubb/core": "5.1.0",
    "@kubb/plugin-faker": "5.0.3",
    "@kubb/plugin-fetch": "5.2.2",
    "@kubb/plugin-msw": "5.0.1",
    "@kubb/plugin-react-query": "5.0.3",
    "@kubb/plugin-ts": "5.0.1",
    "@kubb/plugin-zod": "5.1.3",
    "@microsoft/tsdoc": "0.16.0",
    "@playwright/test": "1.62.1",
    "@rspack/cli": "2.2.2",
    "@rspack/core": "2.2.2",
    "@rspack/dev-server": "2.2.1",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "cspell": "10.2.0",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-markdownlint": "0.10.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.8.0-rc.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "knip": "6.34.0",
    "kubb": "5.1.0",
    "lefthook": "2.1.12",
    "mobx-react-lite": "4.1.1",
    "msw": "2.15.0",
    "postcss": "8.5.26",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
